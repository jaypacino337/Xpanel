# --- Panel ---
PORT=3000
# Public URL of the panel; the OAuth callback is BASE_URL/oauth/callback
BASE_URL=http://localhost:3000
# Password for the panel login
PANEL_PASSWORD=change-me
# Random secret for signing session cookies:  openssl rand -hex 32
SESSION_SECRET=
# 32-byte key (64 hex chars) for encrypting stored X tokens:  openssl rand -hex 32
TOKEN_ENC_KEY=
DB_PATH=data/xpanel.db

# --- X API (developer.x.com -> your app -> OAuth 2.0, type "Web App") ---
X_CLIENT_ID=
X_CLIENT_SECRET=
# Set to 1 to run without X credentials (fake accounts and API)
X_MOCK=0

# Time zone for new accounts' posting slots and CSV times (IANA name, e.g. America/New_York)
DEFAULT_TIMEZONE=UTC
# Where uploaded images are kept (default: next to the database)
# MEDIA_DIR=data/media

# --- Optional ---
# Enables AI-drafted replies and posts (people still review and send them)
ANTHROPIC_API_KEY=
# Slack or Discord incoming-webhook URL for alerts (failed posts, expired client access)
ALERT_WEBHOOK_URL=

# --- Limits ---
# Cap on connected accounts (1-100)
MAX_ACCOUNTS=10
# How many accounts are worked on in parallel by background jobs
X_CONCURRENCY=5
# Posts (incl. thread parts and replies) a single account may send per 24h
DAILY_POST_CAP=25
MENTIONS_POLL_MINUTES=15
METRICS_POLL_MINUTES=60

# --- Deployment ---
# Which proxies to trust for client IPs: "loopback" (proxy on the same machine), a hop count like 1, or a subnet list
TRUST_PROXY=loopback
